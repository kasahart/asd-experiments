{
  "name": "asd-experiments (CUDA)",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--gpus", "all"],
  "remoteUser": "vscode",
  // .venv lives in a container volume so it never mixes with a host .venv.
  "mounts": [
    "source=asd-experiments-venv-${devcontainerId},target=${containerWorkspaceFolder}/.venv,type=volume"
  ],
  "containerEnv": {
    "TORCH_INDEX_URL": "https://download.pytorch.org/whl/cu128",
    "ASD_REQUIRE_CUDA": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "marimo-team.vscode-marimo"]
    }
  }
}
